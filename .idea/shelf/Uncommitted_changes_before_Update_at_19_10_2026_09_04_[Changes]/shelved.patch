--- /dev/null	(date 1792392849149)
+++ b/Script 3/delete_from_database.py	(date 1792392849149)
@@ -0,0 +1,26 @@
+#Script #3
+#Et script til at tømme tabellerne for data. Her bruges DELETE FROM kommandoen.
+
+import sqlite3
+conn = sqlite3.connect('delete_from_database.db')
+cursor = conn.cursor()
+
+cursor.execute("""
+CREATE TABLE IF NOT EXISTS delete_from_database (
+    id INTEGER PRIMARY KEY,
+    name TEXT,
+    number INTEGER
+    )
+""")
+
+cursor.execute("""
+               INSERT INTO delete_from_database (name, number) VALUES ('Erik', 8);
+               INSERT INTO delete_from_database (name, number) VALUES ('Mikkel', 23);
+               INSERT INTO delete_from_database (name, number) VALUES ('Sofie', 14);
+               INSERT INTO delete_from_database (name, number) VALUES ('Andreas', 37);
+               INSERT INTO delete_from_database (name, number) VALUES ('Emma', 5);
+               """)
+
+
+# Ændringen skrives til databasen, samt den gemmes.
+conn.commit()
